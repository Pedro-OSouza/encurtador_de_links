FROM php:8.2-apache

# Instala extensões e dependências que o Laravel precisa
RUN apt-get update && apt-get install -y \
    git unzip libpq-dev libonig-dev libxml2-dev \
    && docker-php-ext-install pdo pdo_pgsql pdo_mysql

# Habilita o mod_rewrite do Apache para as rotas do Laravel funcionarem
RUN a2enmod rewrite

# Aponta o DocumentRoot do Apache para a pasta public do Laravel
ENV APACHE_DOCUMENT_ROOT /var/www/html/public
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/sites-available/*.conf
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/conf-available/*.conf

# Instala o Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html
COPY . .

# Instala dependências e ajusta permissões
RUN composer install --no-dev --optimize-autoloader
RUN chown -R www-data:www-data storage bootstrap/cache

EXPOSE 80

# Executa as migrações e inicia o Apache
CMD php artisan migrate --force && apache2-foreground

# .. 